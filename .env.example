# Puerto del servidor HTTP/WebSocket
PORT=4000

# URL de conexion a PostgreSQL (la da Railway o tu Postgres local)
# Local ejemplo: postgresql://postgres:postgres@localhost:5432/chat?schema=public
DATABASE_URL=

# Secreto para firmar los JWT (usar un valor largo y aleatorio en produccion)
JWT_SECRET=cambiar-esto-por-un-secreto-largo-y-aleatorio

# Tiempo de expiracion del token
JWT_EXPIRES_IN=7d

# Origen permitido para CORS (URL del cliente React)
# Local: http://localhost:5173 | Produccion: https://tu-front.up.railway.app
# Tambien se usa para construir los links de verificacion y recuperacion
# que se envian por correo (ej. CLIENT_ORIGIN/verify-email?token=...).
CLIENT_ORIGIN=http://localhost:5173

# --- Resend para envio de correos (verificacion de email y recuperacion) ---
# API key de https://resend.com (Dashboard > API Keys). Se usa via API HTTP,
# no SMTP: Railway bloquea/filtra los puertos salientes que usa SMTP.
RESEND_API_KEY=
# Remitente que veran los usuarios en el correo. Sin dominio propio verificado
# en Resend, usar "onboarding@resend.dev" (funciona en cualquier entorno pero
# solo permite enviar a la casilla con la que te registraste en Resend).
MAIL_FROM="pub <no-reply@pub.novamicktools.com>"

# --- Cloudinary (subida de avatares de perfil) ---
# Opcional: si faltan, el endpoint de subida de avatar responde 503.
# El API secret vive SOLO aqui (server), nunca en el cliente.
# Dashboard de Cloudinary: Cloud name, API Key, API Secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
