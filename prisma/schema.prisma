// Schema de Prisma para el sistema de chat.
// Modelo: usuarios, salas, membresia de salas y mensajes (de sala o privados).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String
  emailVerified Boolean  @default(false)
  avatarUrl     String?
  createdAt     DateTime @default(now())

  // Nombre visible editable (username es el handle inmutable). Null = usar
  // el username como display name.
  alias         String?
  bio           String?
  // Hex de una paleta cerrada (ver PROFILE_COLORS en constants.js), validado
  // server-side. Null = sin color custom.
  profileColor  String?

  createdRooms           Room[]       @relation("RoomCreator")
  memberships            RoomMember[]
  sentMessages           Message[]    @relation("MessageSender")
  receivedDMs            Message[]    @relation("MessageRecipient")
  sentFriendRequests     Friendship[] @relation("RequestSender")
  receivedFriendRequests Friendship[] @relation("RequestReceiver")
  reactions              Reaction[]
  readMarks              ReadMark[]
}

model Room {
  id        String   @id @default(uuid())
  name      String   @unique
  // Opcional: la sala global es "del sistema" (sin creador). Las salas que
  // crean los usuarios si llevan createdBy.
  createdBy String?
  // Una sala privada no aparece en la lista publica: solo se entra con su
  // codigo de invitacion. Toda sala de usuario tiene inviteCode (tambien las
  // publicas, para poder invitar por DM); la global no tiene (null).
  isPrivate  Boolean @default(false)
  inviteCode String? @unique
  createdAt DateTime @default(now())

  creator  User?        @relation("RoomCreator", fields: [createdBy], references: [id])
  members  RoomMember[]
  messages Message[]
}

model RoomMember {
  userId   String
  roomId   String
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
}

// Un Message es de sala si tiene roomId, o un DM si tiene recipientId.
model Message {
  id          String   @id @default(uuid())
  content     String
  // Imagen adjunta (URL de Cloudinary, subida por HTTP antes de emitir el
  // mensaje). Un mensaje puede ser solo imagen (content vacio), solo texto,
  // o ambos (imagen con caption).
  imageUrl    String?
  senderId    String
  roomId      String?
  recipientId String?
  // Respuesta a otro mensaje (estilo Discord). Opcional. Si se borra el mensaje
  // citado, la respuesta queda con replyToId null (SetNull), no se borra.
  replyToId   String?
  // Ultima edicion del contenido (null = nunca editado). Solo el autor edita.
  editedAt    DateTime?
  // Fijado en su sala (null = no fijado). Solo aplica a mensajes de sala;
  // cualquier miembro fija/desfija (estilo Slack, sin permisos finos).
  pinnedAt    DateTime?
  createdAt   DateTime @default(now())

  sender    User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  room      Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  recipient User?     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")
  reactions Reaction[]

  @@index([roomId, createdAt])
  @@index([senderId, recipientId, createdAt])
}

// Reaccion de un usuario a un mensaje con un emoji de la paleta cerrada
// (REACTION_EMOJIS en constants.js, validada server-side). La PK compuesta
// hace el toggle trivial: crear si no existe, borrar si ya estaba.
model Reaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
}

// Hasta cuando leyo el usuario cada conversacion. chatKey usa el formato
// 'room:<roomId>' (incluida la global, por su id real) o 'dm:<partnerId>'.
// La fila se crea la primera vez que el usuario ABRE la conversacion; sin
// fila, los no leidos de esa conversacion cuentan 0 (techo aceptado).
model ReadMark {
  userId     String
  chatKey    String
  lastReadAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, chatKey])
}

//una amistad requiere de dos usuarios
model Friendship {
  id           String          @id @default(uuid())
  //el que la envia
  userId       String
  //el que aprueba o no
  friendId     String
  state        FriendshipState
  requestDate  DateTime        @default(now())
  approvalDate DateTime?
  blockingDate DateTime?
  createdAt    DateTime        @default(now())
  sender       User            @relation("RequestSender", fields: [userId], references: [id], onDelete: Cascade)
  receiver     User            @relation("RequestReceiver", fields: [friendId], references: [id], onDelete: Cascade)

  //indices para busquedas
  @@index([userId])
  @@index([friendId])
  // Un unico vinculo por par (direccion emisor->receptor): evita solicitudes
  // duplicadas. La direccion inversa se controla a nivel app (findFirst con OR).
  @@unique([userId, friendId])
}

enum FriendshipState {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}
